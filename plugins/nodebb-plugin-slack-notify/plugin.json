{
	"id": "nodebb-plugin-slack-notify",
	"name": "Slack Notify",
	"description": "Send Slack notifications when new posts and replies are created",
	"url": "https://github.com/speek/nodebb-plugin-slack-notify",
	"library": "./library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "action:post.save", "method": "onPostSave" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" }
	]
}
